<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>UkrUtils.Katottg.Tool</RootNamespace>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>katottg</ToolCommandName>
        <PackageId>UkrUtils.Katottg.Tool</PackageId>
        <Description>CLI для КАТОТТГ: імпорт офіційного xlsx, побудова знімка, пошук.</Description>
        <PackageTags>katottg;ukraine;codifier;cli</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UkrUtils.Katottg.Import\UkrUtils.Katottg.Import.csproj" />
    </ItemGroup>

</Project>
