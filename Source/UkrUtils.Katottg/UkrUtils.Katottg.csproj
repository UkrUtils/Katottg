<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>UkrUtils.Katottg</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageId>UkrUtils.Katottg</PackageId>
        <Description>Кодифікатор адміністративно-територіальних одиниць та територій територіальних громад (КАТОТТГ): пошук, ієрархія, валідація кодів. Містить вбудований знімок офіційних даних.</Description>
        <PackageTags>katottg;ukraine;codifier;кодифікатор;катоттг</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Data\katottg.bin.gz" LogicalName="UkrUtils.Katottg.Data.katottg.bin.gz" Condition="Exists('Data\katottg.bin.gz')" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="UkrUtils.Katottg.Tests" />
        <InternalsVisibleTo Include="UkrUtils.Katottg.Benchmarks" />
    </ItemGroup>

</Project>
